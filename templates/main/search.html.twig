{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link href="{{ asset('css/bootstrap.min.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="container-fluid pt-5">
    <div class="row mt-5">
        <div class="offset-sm-2 col-sm-8">
            <div class="card">
                <div class="card-header">
                    Searching request for
                    <strong>{{ firstname|capitalize }} {{ lastname|capitalize }} in {{ city|capitalize }}, {{ state|upper }}</strong>
                    among over 300+ data brokers.
                </div>

                <div class="card-body">
                    <div class="invisible" id="step-1">
                        <span>Collecting all data brokers...</span>
                        <div class="spinner-border ms-auto spinner-border-sm text-primary"
                             id="spinner-1"
                             role="status"
                             aria-hidden="true"
                        ></div>
                        <span class="text-success invisible" id="done-1">OK</span>
                    </div>

                    <div class="invisible" id="step-2">
                        <span>Checking data brokers availability...</span>
                        <div class="spinner-border ms-auto spinner-border-sm text-primary"
                             id="spinner-2"
                             role="status"
                             aria-hidden="true"
                        ></div>
                        <span class="text-success invisible" id="done-2">OK</span>
                    </div>

                    <div class="invisible" id="step-3">
                        <span>Preparing search requests...</span>
                        <div class="spinner-border ms-auto spinner-border-sm text-primary"
                             id="spinner-3"
                             role="status"
                             aria-hidden="true"
                        ></div>
                        <span class="text-success invisible" id="done-3">OK</span>
                    </div>

                    <div class="invisible" id="step-4">
                        <span id="header-4">Making a search request for <strong id="data-broker"></strong></span>
                        <div class="spinner-border ms-auto spinner-border-sm text-primary"
                             id="spinner-4"
                             role="status"
                             aria-hidden="true"
                        ></div>
                        <span class="text-success invisible" id="done-4">OK</span>
                    </div>

                    <h5 class="card-title mt-5">Total progress</h5>

                    <div class="progress" style="height: 25px; font-weight: bold;">
                        <div class="progress-bar bg-info progress-bar-animated progress-bar-striped"
                             id="progress-bar"
                             role="progressbar"
                             style="width: 0;"
                        >0%</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/bootstrap.bundle.min.js') }}"></script>
    <script src="{{ asset('js/jquery.min.js') }}"></script>
    <script>
        async function sleep(ms) {
            return new Promise(resolve => setTimeout(resolve, ms));
        }

        function randomIndex(max) {
            return Math.floor(Math.random() * max);
        }

        function random(min, max) {
            return Math.floor(Math.random() * (max - min + 1) ) + min;
        }

        async function go() {
            const dataBrokers = ["peopleconnect.us","www.truthfinder.com","www.datafacts.com","members.infotracer.com","www.experian.com","www.intellicorp.net","www.nctue.com","www.allareacodes.com","www.inteligator.com","www.advantagesolutions.net","thatsthem.com","www.infopay.com","www.instantpeoplefinder.com","www.census-info.us","peoplelookup.com","www.equifax.com","www.criminalpages.com","www.verisk.com","sortedbyname.com","www.sagestreamllc.com","businessprofiles.com","modernize.com","www.theworknumber.com","www.fusedleads.com","socialcatfish.com","www.clarityservices.com","reversenumberdatabase.com","www.i-360.com","recordsauthority.com","www.viantinc.com","www.locatefamily.com","www.corelogic.com","aslmarketing.com","www.refinitiv.com","ruf.com","www.sterlingcheck.com","incheck.net","www.valassis.com","www.pipl.com","v2.parasolleads.com","lead.co","www.kbmg.com","webbula.com","www.allwebleads.com","www.inflection.com","www.myyp.com","www.ciccredit.com","whitepages.plus","sortedbybirthdate.com","www.backgroundsonline.com","govregistry.us","www.civisanalytics.com","www.detectiveunlimited.com","www.searchbug.com","www.oracle.com","www.infogroup.com","www.background-check-only.com","v12data.com","fi.deluxe.com","secure.publicrecords.com","www.snoopstation.com","www.whoodle.com","www.criminalbackgroundrecords.com","www.ancestry.com","www.truedata.co","www.fullcontact.com","www.cbcinnovis.com","forewarn.com","deathrecords.org","intelregistry.com","www.partnerscredit.com","infocore.com","digitalmediasolutions.com","www.cicreports.com","dataxltd.com","www.bisi.com","www.peoplesmart.com","risk.lexisnexis.com","revealmobile.com","www.staterecords.org","www.edvisors.com","www.marriagerecords.org","www.reversegenie.com","publicrecords.onlinesearches.com","ihsmarkit.com","www.instantcheckmate.com","www.peopleconnect.us","www.transunion.com","www.tracersinfoonline.com","www.belardiwong.com","www.addresssearch.com","www.goodhire.com","www.publicarrestrecords.org","www.blackknightinc.com","www.datatree.com","www.home.neustar","www.amrent.com","www.peoplebyname.com","www.whitepages.com","www.speedeondata.com","www.healthcare.com","courtregistry.org","www.govarrestrecords.org","www.background-checks-systems.com","www.superpages.com","avrickdirect.com","www.thomsonreuters.com","www.hireright.com","wiland.com","plusaddress.com","www.tlo.com","www.factualdata.com","governmentregistry.org","path2response.com","www.spydialer.com","firstorion.com","www.yasni.com","databaseusa.com","studentclearinghouse.org","strategicinfo.com","www.mocavo.com","www.emailtracer.com","www.nationalbackgroundcheck.com","www.phoneregistry.com","www.spokeo.com","www.enformion.com","www.ucc411.com","www.dataverify.com","publicrecordschecks.com","www.public-record-site.com","datastreamgroup.com","www.firstdirectmarketing.com","www.411.com","www.criminalscreen.com","www.tenantdetective.com","altisource.com","www.skipsmasher.com","www.reversemobile.com","www.courtrecords.org","ididata.com","www.kgbpeople.com","www.earlywarning.com","www.compactlists.com","info.persopo.com","www.phonebooks.com","cupidscreen.com","freecellsearch.com","www.peopleg2.com","reverserecords.org","kw1.knowwho.com","www.backgroundchecks.com","www.idanalytics.com","www.cortera.com","www.cdkglobal.com","www.advcredit.com","www.ypstate.com","www.blackbaud.com","publicrecordssearchonline.org","us.epsilon.com","freebackgroundcheck.us","www.divorcerecords.org","www.700credit.com","mapsmoji.com","cellphoneregistry.com","www.peekyou.com","www.libertydata.net","www.possiblenow.com","assurance.com","instantbackgroundreport.com","analytics-iq.com","www.beenverified.com","www.criminalwatchdog.com","www.reversephonelookup.com","www.dataamerica.com","www.openonline.com","www.peoplefinderonline.net","segment.com","www.easybackgrounds.com","www.bridgevine.com","blockshopper.com","www.zoominfo.com","acxiom.com","www.accudata.com","www.corporationwiki.com","www.lciinc.com","www.alc.com","www.advancedbackgroundchecks.com","mchdata.com","www.voterfactory.com","www.owneriq.com","peopleaz.org","infutor.com","www.towerdata.com"],
                  $progressbar = $('#progress-bar');

            let intervalId = null;

            $('#step-1').toggleClass('invisible');

            for (let i = 1; i <= 100; i++) {
                await sleep(i < 45 ? random(100, 200) : random(300, 400));

                if (i === 15) {
                    $('#spinner-1').toggleClass('invisible');
                    $('#done-1').toggleClass('invisible');
                    $('#step-2').toggleClass('invisible');
                }

                if (i === 35) {
                    $('#spinner-2').toggleClass('invisible');
                    $('#done-2').toggleClass('invisible');
                    $('#step-3').toggleClass('invisible');
                }

                if (i === 45) {
                    $('#spinner-3').toggleClass('invisible');
                    $('#done-3').toggleClass('invisible');
                    $('#step-4').toggleClass('invisible');

                    intervalId = setInterval(() => {
                        $('#data-broker').html(dataBrokers[randomIndex(dataBrokers.length)]);
                    }, 150);
                }

                if (i === 15 || i === 35 || i === 65 || i === 95) {
                    await sleep(random(500, 1000));
                }

                $progressbar.css('width', i + '%').html(i + '%');
            }

            clearInterval(intervalId);

            $('#header-4').html('Done');
            $('#spinner-4').toggleClass('invisible');
            $('#done-4').toggleClass('invisible');

            $progressbar.removeClass('progress-bar-striped');
            $progressbar.removeClass('progress-bar-animated');

            window.location.replace('{{ path('dashboard') }}');
        }

        $(document).ready(() => {
            go();
        });
    </script>
{% endblock %}
